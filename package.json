{
  "name": "pet-with-you",
  "version": "0.1.0-alpha.7.1.4",
  "private": true,
  "main": "bootstrap.cjs",
  "scripts": {
    "start": "node scripts/dev.cjs",
    "dev": "node scripts/dev.cjs",
    "test": "node --test test/*.test.cjs",
    "doctor": "node scripts/doctor.cjs",
    "test:ui": "node scripts/run-isolated.cjs test",
    "media:record": "node scripts/run-isolated.cjs demo",
    "media:animations": "node scripts/export-animations.cjs",
    "check:docs": "node scripts/check-docs.cjs",
    "dist:win": "electron-builder --config electron-builder.cjs --win nsis --x64 --publish never",
    "pack:win": "electron-builder --config electron-builder.cjs --win --x64 --dir --publish never",
    "audit:source": "node scripts/audit-source.cjs",
    "media:catalog": "node scripts/build-animation-catalog.cjs"
  },
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3"
  },
  "description": "Windows desktop pet with optional Codex task feedback and OpenAI-compatible chat",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Refining-colors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Refining-colors/pet-with-you.git"
  },
  "homepage": "https://github.com/Refining-colors/pet-with-you",
  "bugs": {
    "url": "https://github.com/Refining-colors/pet-with-you/issues"
  },
  "license": "MIT"
}
